{
  "name": "Genius Chess Academy — جمعية الشطرنج القاسمي",
  "short_name": "Genius Chess",
  "description": "Plateforme officielle de gestion, présences par QR Code, plannings et suivi de Genius Chess Academy",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "window-controls-overlay",
    "minimal-ui"
  ],
  "background_color": "#0A192F",
