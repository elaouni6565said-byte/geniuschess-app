      "icons": [
        {
          "src": "/static/img/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Planning",
      "short_name": "Planning",
      "description": "Emploi du temps et séances",
      "url": "/planning/",
      "icons": [
        {
          "src": "/static/img/icons/icon-192.png",
          "sizes": "192x192"
        }
